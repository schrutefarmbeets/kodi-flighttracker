<?xml version="1.0" encoding="UTF-8"?>
<!--
  Deliberately thin. The board rows vary in number (1, 2 or 3) and in width
  (full screen, or squeezed beside a radar or map), so they are built in
  gui.py where that can be calculated. This file is only the fixed furniture:
  background, header, the radar/map panel, and the button strip.

  Font names are the ones Estuary actually defines: font10 (23px), font12 (25),
  font13 (30), font14 (33), font27, font32, font37, font45, font60. Anything
  else silently falls back to the 30px default.
-->
<window>
  <defaultcontrol always="true">200</defaultcontrol>
  <controls>

    <!-- board carcass -->
    <control type="image" id="100">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <texture colordiffuse="FF0A0A0A">special://home/addons/script.flighttracker/resources/media/white.png</texture>
    </control>

    <!-- header -->
    <control type="image" id="101">
      <left>0</left>
      <top>0</top>
