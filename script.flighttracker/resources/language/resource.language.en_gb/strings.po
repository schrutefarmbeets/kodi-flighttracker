msgid "Roughly your floor height plus local ground elevation. Used to work out how high above the horizon each aircraft appears."
msgstr ""

msgctxt "#30017"
msgid "Detect position from internet connection"
msgstr ""

msgctxt "#30018"
msgid "Looks up an approximate position for your internet connection. Expect to be off by a few kilometres, so fine-tune the values afterwards."
msgstr ""

