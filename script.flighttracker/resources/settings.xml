<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings version="1">
  <section id="script.flighttracker">

    <category id="location" label="30001">
      <group id="1" label="30010">
        <setting id="home_lat" type="string" label="30011" help="30012">
          <level>0</level>
          <default>13.7280</default>
          <constraints>
            <allowempty>false</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>30011</heading>
          </control>
        </setting>
        <setting id="home_lon" type="string" label="30013" help="30014">
          <level>0</level>
          <default>100.5820</default>
          <constraints>
            <allowempty>false</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>30013</heading>
          </control>
        </setting>
        <setting id="observer_alt_m" type="integer" label="30015" help="30016">
          <level>0</level>
          <default>110</default>
          <constraints>
            <minimum>0</minimum>
            <step>5</step>
            <maximum>800</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
        <setting id="detect_location" type="action" label="30017" help="30018">
          <level>0</level>
          <data>RunScript(script.flighttracker,detectlocation)</data>
          <control type="button" format="action">
            <close>false</close>
          </control>
        </setting>
      </group>

      <group id="2" label="30020">
        <setting id="view_bearing" type="integer" label="30021" help="30022">
          <level>0</level>
          <default>110</default>
          <constraints>
            <minimum>0</minimum>
            <step>5</step>
            <maximum>355</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
        <setting id="view_fov" type="integer" label="30023" help="30024">
          <level>0</level>
          <default>140</default>
          <constraints>
            <minimum>30</minimum>
            <step>10</step>
            <maximum>360</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
        <setting id="only_visible" type="boolean" label="30025" help="30026">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
        <setting id="orient_radar" type="boolean" label="30027" help="30028">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
      </group>
    </category>

    <category id="source" label="30002">
      <group id="1" label="30030">
        <setting id="source" type="integer" label="30031">
          <level>0</level>
          <default>0</default>
          <constraints>
            <options>
              <option label="30032">0</option>
              <option label="30033">1</option>
              <option label="30034">2</option>
            </options>
          </constraints>
          <control type="spinner" format="string"/>
        </setting>
        <setting id="local_url" type="string" label="30035" help="30036">
          <level>0</level>
          <default>http://127.0.0.1:8080</default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <dependencies>
            <dependency type="visible">
              <condition on="setting" setting="source" operator="is">2</condition>
            </dependency>
          </dependencies>
          <control type="edit" format="string">
            <heading>30035</heading>
          </control>
        </setting>
        <setting id="radius_nm" type="integer" label="30037">
          <level>0</level>
          <default>60</default>
          <constraints>
            <minimum>5</minimum>
            <step>5</step>
            <maximum>250</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
        <setting id="refresh_sec" type="integer" label="30038">
          <level>0</level>
          <default>8</default>
          <constraints>
            <minimum>3</minimum>
            <step>1</step>
            <maximum>60</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
        <setting id="max_flights" type="integer" label="30039">
          <level>0</level>
          <default>40</default>
          <constraints>
            <minimum>5</minimum>
            <step>5</step>
            <maximum>150</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
      </group>

      <group id="2" label="30040">
        <setting id="airport_primary" type="string" label="30041" help="30042">
          <level>0</level>
          <default>VTBS</default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>30041</heading>
          </control>
        </setting>
        <setting id="airport_secondary" type="string" label="30043" help="30044">
          <level>0</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>30043</heading>
          </control>
        </setting>
      </group>

      <group id="3" label="30050">
        <setting id="lookup_routes" type="boolean" label="30051" help="30052">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="route_cache_days" type="integer" label="30053">
          <level>1</level>
          <default>30</default>
          <constraints>
            <minimum>1</minimum>
            <step>1</step>
            <maximum>180</maximum>
          </constraints>
          <dependencies>
            <dependency type="enable">
              <condition on="setting" setting="lookup_routes" operator="is">true</condition>
            </dependency>
          </dependencies>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
      </group>
    </category>

    <category id="filters" label="30003">
      <group id="1" label="30060">
        <setting id="min_alt_ft" type="integer" label="30061">
          <level>0</level>
          <default>0</default>
          <constraints>
            <minimum>0</minimum>
            <step>500</step>
            <maximum>40000</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
        <setting id="max_alt_ft" type="integer" label="30062">
          <level>0</level>
          <default>45000</default>
          <constraints>
            <minimum>1000</minimum>
            <step>1000</step>
            <maximum>50000</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
        <setting id="hide_ground" type="boolean" label="30063">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
      </group>

      <group id="2" label="30070">
        <setting id="show_arrivals" type="boolean" label="30076">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="show_departures" type="boolean" label="30077">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="show_overflights" type="boolean" label="30078" help="30079">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
      </group>
    </category>

    <category id="display" label="30004">
      <group id="1" label="30088">
        <setting id="view_mode" type="integer" label="30084">
          <level>0</level>
          <default>0</default>
          <constraints>
            <options>
              <option label="30085">0</option>
              <option label="30086">1</option>
              <option label="30087">2</option>
            </options>
          </constraints>
          <control type="spinner" format="string"/>
        </setting>
        <setting id="show_logos" type="boolean" label="30089">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="flap_animation" type="boolean" label="30096" help="30097">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="radar_labels" type="boolean" label="30083">
          <level>0</level>
          <default>true</default>
          <dependencies>
            <dependency type="enable">
              <condition on="setting" setting="view_mode" operator="!is">0</condition>
            </dependency>
          </dependencies>
          <control type="toggle"/>
        </setting>
        <setting id="units" type="integer" label="30080">
          <level>0</level>
          <default>0</default>
          <constraints>
            <options>
              <option label="30081">0</option>
              <option label="30082">1</option>
            </options>
          </constraints>
          <control type="spinner" format="string"/>
        </setting>
      </group>
    </category>

    <category id="alerts" label="30005">
      <group id="1" label="30090">
        <setting id="notify_enabled" type="boolean" label="30091" help="30092">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
        <setting id="notify_dist_nm" type="integer" label="30093">
          <level>0</level>
          <default>8</default>
          <constraints>
            <minimum>1</minimum>
            <step>1</step>
            <maximum>50</maximum>
          </constraints>
          <dependencies>
            <dependency type="enable">
              <condition on="setting" setting="notify_enabled" operator="is">true</condition>
            </dependency>
          </dependencies>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
        <setting id="notify_alt_ft" type="integer" label="30094">
          <level>0</level>
          <default>12000</default>
          <constraints>
            <minimum>1000</minimum>
            <step>1000</step>
            <maximum>45000</maximum>
          </constraints>
          <dependencies>
            <dependency type="enable">
              <condition on="setting" setting="notify_enabled" operator="is">true</condition>
            </dependency>
          </dependencies>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
        <setting id="notify_cooldown_sec" type="integer" label="30095">
          <level>0</level>
          <default>120</default>
          <constraints>
            <minimum>15</minimum>
            <step>15</step>
            <maximum>1800</maximum>
          </constraints>
          <dependencies>
            <dependency type="enable">
              <condition on="setting" setting="notify_enabled" operator="is">true</condition>
            </dependency>
          </dependencies>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
      </group>
    </category>

  </section>
</settings>
